<%= form_with(model: hospital_referencia) do |form| %>
  <%= render "shared/errores", registro: hospital_referencia %>

  <div class="campo">
    <%= form.label :nombre %>
    <%= form.text_field :nombre %>
  </div>

  <div class="campo">
    <%= form.label :tipo_red_id %>
    <%= form.collection_select :tipo_red_id, TipoRed.order(:nombre), :id, :nombre,
          { prompt: "Seleccione un tipo de red" } %>
  </div>

  <div class="campo">
    <%= form.label :telefono %>
    <%= form.telephone_field :telefono %>
  </div>

  <%= form.submit "Guardar" %>
<% end %>
