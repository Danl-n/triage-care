<% content_for :title, @quirofano.nombre %>

<h1><%= @quirofano.nombre %></h1>

<p><strong><%= Quirofano.human_attribute_name(:estado) %>:</strong> <%= texto_enum(Quirofano, :estado, @quirofano.estado) %></p>

<p>
  <%= link_to "Editar", edit_quirofano_path(@quirofano) %> |
  <%= link_to "Volver al listado", quirofanos_path %>
</p>

<%= button_to "Eliminar", @quirofano, method: :delete,
      form: { data: { turbo_confirm: "¿Seguro que deseas eliminar este quirófano?" } } %>
