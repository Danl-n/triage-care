<%= form_with(model: quirofano) do |form| %>
  <%= render "shared/errores", registro: quirofano %>

  <div class="campo">
    <%= form.label :nombre %>
    <%= form.text_field :nombre %>
  </div>

  <div class="campo">
    <%= form.label :estado %>
    <%= form.select :estado, opciones_enum(Quirofano, :estado) %>
  </div>

  <%= form.submit "Guardar" %>
<% end %>
