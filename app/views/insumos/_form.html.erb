<%= form_with(model: insumo) do |form| %>
  <%= render "shared/errores", registro: insumo %>

  <div class="campo">
    <%= form.label :nombre %>
    <%= form.text_field :nombre %>
  </div>

  <div class="campo">
    <%= form.label :unidad %>
    <%= form.text_field :unidad, placeholder: "unidad, ml, caja, frasco..." %>
  </div>

  <div class="campo">
    <%= form.label :stock_disponible %>
    <%= form.number_field :stock_disponible, min: 0, step: 1 %>
  </div>

  <%= form.submit "Guardar" %>
<% end %>
