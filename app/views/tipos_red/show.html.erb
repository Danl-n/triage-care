<% content_for :title, @tipo_red.nombre %>

<h1><%= @tipo_red.nombre %></h1>

<p><strong><%= TipoRed.human_attribute_name(:descripcion) %>:</strong> <%= @tipo_red.descripcion %></p>

<h2>Hospitales de referencia (<%= @hospitales.size %>)</h2>
<ul>
  <% @hospitales.each do |hospital| %>
    <li><%= link_to hospital.nombre, hospital %></li>
  <% end %>
</ul>

<p>
  <%= link_to "Editar", edit_tipo_red_path(@tipo_red) %> |
  <%= link_to "Volver al listado", tipos_red_path %>
</p>

<%= button_to "Eliminar", @tipo_red, method: :delete,
      form: { data: { turbo_confirm: "¿Seguro que deseas eliminar este tipo de red?" } } %>
