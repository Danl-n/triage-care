<%= form_with(model: tipo_red) do |form| %>
  <%= render "shared/errores", registro: tipo_red %>

  <div class="campo">
    <%= form.label :nombre %>
    <%= form.text_field :nombre %>
  </div>

  <div class="campo">
    <%= form.label :descripcion %>
    <%= form.text_field :descripcion %>
  </div>

  <%= form.submit "Guardar" %>
<% end %>
