<%= form_with(model: provincia) do |form| %>
  <%= render "shared/errores", registro: provincia %>

  <div class="campo">
    <%= form.label :codigo %>
    <%= form.text_field :codigo, maxlength: 2, inputmode: "numeric", placeholder: "17" %>
  </div>

  <div class="campo">
    <%= form.label :nombre %>
    <%= form.text_field :nombre %>
  </div>

  <%= form.submit "Guardar" %>
<% end %>
