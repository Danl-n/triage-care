<% content_for :title, @canton.nombre %>

<h1><%= @canton.nombre %></h1>

<p>
  <strong><%= Canton.human_attribute_name(:provincia) %>:</strong>
  <%= link_to @canton.provincia.nombre, @canton.provincia %>
</p>

<p>
  <%= link_to "Editar", edit_canton_path(@canton) %> |
  <%= link_to "Volver al listado", cantones_path %>
</p>

<%= button_to "Eliminar", @canton, method: :delete,
      form: { data: { turbo_confirm: "¿Seguro que deseas eliminar este cantón?" } } %>
