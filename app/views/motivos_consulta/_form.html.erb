<%= form_with(model: motivo_consulta) do |form| %>
  <%= render "shared/errores", registro: motivo_consulta %>

  <div class="campo">
    <%= form.label :nombre %>
    <%= form.text_field :nombre %>
  </div>

  <div class="campo">
    <%= form.label :especialidad_id %>
    <%= form.collection_select :especialidad_id, Especialidad.order(:nombre), :id, :nombre,
          { prompt: "Seleccione una especialidad" } %>
  </div>

  <div class="campo campo-check">
    <%= form.check_box :requiere_quirofano %>
    <%= form.label :requiere_quirofano %>
  </div>

  <div class="campo campo-check">
    <%= form.check_box :requiere_anestesista %>
    <%= form.label :requiere_anestesista %>
  </div>

  <div class="campo">
    <%= form.label :duracion_estimada_minutos %>
    <%= form.number_field :duracion_estimada_minutos, min: 1, step: 1 %>
  </div>

  <fieldset>
    <legend><%= MotivoConsulta.human_attribute_name(:insumos_requeridos) %></legend>
    <p><small>Deje en blanco las filas que no use. Marque "Quitar" para eliminar un insumo ya guardado.</small></p>

    <table>
      <thead>
        <tr>
          <th><%= InsumoRequerido.human_attribute_name(:insumo) %></th>
          <th><%= InsumoRequerido.human_attribute_name(:cantidad) %></th>
          <th>Quitar</th>
        </tr>
      </thead>
      <tbody>
        <%= form.fields_for :insumos_requeridos do |fila| %>
          <tr>
            <td>
              <%= fila.collection_select :insumo_id, Insumo.order(:nombre), :id, :nombre,
                    { include_blank: "—" } %>
            </td>
            <td><%= fila.number_field :cantidad, min: 1, step: 1 %></td>
            <td><%= fila.check_box :_destroy if fila.object.persisted? %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </fieldset>

  <%= form.submit "Guardar" %>
<% end %>
